{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": [
        "https://twozero3213-beep.github.io/renewmap-site/",
        "https://twozero3213-beep.github.io/renewmap-site/explore.html",
        "https://twozero3213-beep.github.io/renewmap-site/field/",
        "https://twozero3213-beep.github.io/renewmap-site/dong/21100660.html"
      ],
      "settings": {
        "preset": "desktop",
        "onlyCategories": [
          "performance",
          "accessibility",
          "best-practices",
          "seo"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ],
            "cumulative-layout-shift": [
              "warn",
              {
                "maxNumericValue": 0.1
              }
            ],
            "largest-contentful-paint": [
              "warn",
              {
                "maxNumericValue": 2500
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.213,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*(/explore\\.html($|\\?)))",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 580,
                "aggregationMethod": "median"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "/explore\\.html($|\\?)",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 1960,
                "aggregationMethod": "median"
              }
            ]
          }
        }
      ]
    }
  }
}
