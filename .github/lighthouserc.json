{
  "ci": {
    "collect": {
      "numberOfRuns": 1,
      "url": [
        "https://twozero3213-beep.github.io/renewmap-site/",
        "https://twozero3213-beep.github.io/renewmap-site/explore.html",
        "https://twozero3213-beep.github.io/renewmap-site/field/",
        "https://twozero3213-beep.github.io/renewmap-site/field/redev.html",
        "https://twozero3213-beep.github.io/renewmap-site/field/oa.html",
        "https://twozero3213-beep.github.io/renewmap-site/field/idle.html"
      ],
      "settings": { "onlyCategories": ["performance", "accessibility", "best-practices", "seo"] }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }]
      }
    }
  }
}
